# Copy to .env then fill in. Never commit the real .env.
# Local usage: docker run --rm --env-file .env <image>
# In production (Serverless Job), pass the keys via Secret Manager rather
# than as plain-text environment variables (see README).

# --- Required ---
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
VOLUME_ID=
BUCKET=

# --- Optional (script defaults) ---
# Volume zone
ZONE=fr-par-1
# Number of .qcow2 exports kept in the bucket
RETENTION=3
# Key root: <PREFIX>/<instance>/autosnap-<date>.qcow2
PREFIX=snapshots
# Export timeout, in seconds
EXPORT_TIMEOUT=7200
# Forces the folder name (default: name of the instance owning the volume)
LABEL=
# Target Scaleway project (read natively by the scw CLI)
SCW_DEFAULT_PROJECT_ID=
