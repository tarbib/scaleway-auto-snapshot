# Copier en .env puis remplir. Ne jamais committer le .env reel.
# Usage local : docker run --rm --env-file .env <image>
# En production (Serverless Job), passer les cles via Secret Manager plutot
# qu'en variables d'environnement en clair (voir README).

# --- Requis ---
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
VOLUME_ID=
BUCKET=

# --- Optionnels (valeurs par defaut du script) ---
# Zone du volume
ZONE=fr-par-1
# Nombre d'exports .qcow2 conserves dans le bucket
RETENTION=3
# Racine des cles : <PREFIX>/<instance>/autosnap-<date>.qcow2
PREFIX=snapshots
# Timeout de l'export, en secondes
EXPORT_TIMEOUT=7200
# Force le nom du dossier (par defaut : nom de l'instance proprietaire du volume)
LABEL=
# Projet Scaleway cible (lu nativement par le CLI scw)
SCW_DEFAULT_PROJECT_ID=
